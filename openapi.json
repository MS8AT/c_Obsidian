    "/api/prism/prototype": {
      "get": {
        "summary": "Read the bundled Domiteli Prism HTML and SHA-256; no vault integration",
        "security": [
          {
            "sessionBearer": []
          },
          {
            "webSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Original prototype source",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "filename",
                    "sha256",
                    "bytes",
                    "preview_url",
                    "content",
                    "kind",
                    "vault_integration"
                  ],
                  "properties": {
                    "filename": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "preview_url": {
                      "const": "/prism"
                    },
                    "content": {
                      "type": "string",
                      "description": "Original UTF-8 HTML, including original line endings."
                    },
                    "kind": {
                      "const": "standalone_prototype"
                    },
                    "vault_integration": {
                      "const": false
                    },
                    "modified": {
                      "type": "boolean"
                    },
                    "original_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "build_version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          }
        },
        "parameters": [
          {
            "name": "original",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            },
            "description": "1 reads bundled original; default reads working copy."
          }
        ]
      },
      "put": {
        "summary": "Import or edit working HTML, preserving bundled original",
        "security": [
          {
            "sessionBearer": []
          },
          {
            "webSession": []
          }
        ],
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Required for production cookie mutations; local bearer mode does not use it.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "content",
                  "expected_sha256"
                ],
                "properties": {
                  "content": {
                    "type": "string",
                    "maxLength": 2097152
                  },
                  "expected_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or protected path"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Read-only, wrong Host/Origin, or invalid CSRF"
