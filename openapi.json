    "/api/login": {
      "post": {
        "summary": "Production login; no vault content is public",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "writeOnly": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session cookie set"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "429": {
            "description": "Rate limit"
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "summary": "Production session and CSRF token",
        "security": [
          {
            "webSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated session"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/logout": {
      "post": {
        "summary": "Revoke current production session",
        "security": [
          {
            "webSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session revoked"
          },
          "403": {
            "description": "Invalid CSRF"
          }
        }
      }
    }
  }
