    "/api/notes/update": {
      "put": {
        "summary": "Update an existing Markdown note with optimistic SHA-256 locking",
        "operationId": "update_note",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "path",
                  "content",
                  "expected_sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "expected_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{64}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Updated"
          },
          "409": {
            "description": "Revision conflict"
          }
        }
      }
    },
