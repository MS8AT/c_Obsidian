{
  "openapi": "3.1.0",
  "info": {
    "title": "c_Obsidian local API",
    "version": "0.2.1",
    "description": "Local bearer API and production cookie-session API. Writes create files only."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ],
  "security": [
    {
      "sessionBearer": []
    },
    {
      "webSession": []
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Transient token in the launch URL fragment."
      },
      "webSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "obsidian_session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Graph": {
        "type": "object",
        "required": [
          "schema",
          "version",
          "policy",
          "notes",
          "edges",
          "summary",
          "warnings"
        ],
        "properties": {
          "schema": {
            "const": "c-obsidian.graph/v1"
          },
          "version": {
            "type": "string"
          },
          "policy": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "target"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                }
              }
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "notes": {
                "type": "integer",
                "minimum": 0
              },
              "links": {
                "type": "integer",
                "minimum": 0
              },
              "unlinked": {
                "type": "integer",
                "minimum": 0
              },
              "maps": {
                "type": "integer",
                "minimum": 0
              },
              "images": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Public health without vault information",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid path or file",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or absent token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Invalid Host or Origin",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
