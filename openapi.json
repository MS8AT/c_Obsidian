        {
          "name": "case_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Read an immutable snapshot",
        "operationId": "get_prism_snapshot",
        "responses": {
          "200": {
            "description": "Snapshot model and hash"
          }
        },
        "description": "Read a previously committed snapshot; never writes events or state, including in read-only mode."
      },
      "post": {
        "summary": "Fix a snapshot without increasing semantic revision",
        "operationId": "create_prism_snapshot",
        "responses": {
          "200": {
