{
  "openapi": "3.1.0",
  "info": {
    "title": "c_Obsidian local API",
    "version": "0.3.2-prism-api",
    "description": "Local bearer API and production cookie-session API. Create-only import, conflict-safe note updates and bounded Prism v1 models."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ],
  "security": [
    {
      "sessionBearer": []
    },
    {
      "webSession": []
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Transient token in the launch URL fragment."
      },
      "webSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "obsidian_session"
      },
      "prismPreview": {
        "type": "apiKey",
        "in": "cookie",
        "name": "c_obsidian_prism_preview",
        "description": "Loopback-only HttpOnly /prism cookie issued after authenticated GET /api/prism/prototype. Gives access only to the HTML preview."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Graph": {
        "type": "object",
        "required": [
          "schema",
          "version",
          "policy",
          "notes",
          "edges",
          "summary",
          "warnings"
        ],
        "properties": {
          "schema": {
            "const": "c-obsidian.graph/v1"
          },
          "version": {
            "type": "string"
          },
          "policy": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "target"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                }
              }
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "notes": {
                "type": "integer",
                "minimum": 0
              },
              "links": {
                "type": "integer",
                "minimum": 0
              },
              "unlinked": {
                "type": "integer",
                "minimum": 0
              },
              "maps": {
                "type": "integer",
                "minimum": 0
              },
              "images": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
